   "source": [
    "# STEP 4 & STEP 5 — LOOCV Method as per section 4.3 of the dissertation with results\n",
    "def _regularize_markov(mdl, eps=1e-6):\n",
    "    \"\"\"Make startprob_ and transmat_ strictly positive and row-normalized.\"\"\"\n",
    "    sp = getattr(mdl, \"startprob_\", None)\n",
    "    if sp is not None:\n",
    "        sp = np.clip(sp, eps, None)\n",
    "        s = sp.sum()\n",
    "        sp = np.full_like(sp, 1.0 / len(sp)) if (not np.isfinite(s) or s <= 0) else sp / s\n",
    "        mdl.startprob_ = sp\n",
    "    tm = getattr(mdl, \"transmat_\", None)\n",
    "    if tm is not None:\n",
    "        tm = np.clip(tm, eps, None)\n",
    "        rs = tm.sum(axis=1, keepdims=True)\n",
    "        bad = (~np.isfinite(rs)) | (rs <= 0)\n",
    "        if bad.any():\n",
    "            tm[bad.flatten()] = 1.0 / tm.shape[1]\n",
    "            rs = tm.sum(axis=1, keepdims=True)\n",
    "        mdl.transmat_ = tm / rs\n",
    "    return mdl\n",
    "\n",
    "def _fit_hmm_models(train_df, n_states=3, n_iter=40, use_pct_change=False):\n",
    "    \"\"\"Fitted 1D GaussianHMM per column on train data only for limitation of processing power.\"\"\"\n",
    "    models = {}\n",
    "    for col in train_df.columns:\n",
    "        series = train_df[col].pct_change() if use_pct_change else train_df[col].diff()\n",
    "        diff = series.dropna()\n",
    "        if len(diff) < 10:\n",
    "\n",
    "            mdl = hmm.GaussianHMM(n_components=n_states, covariance_type='diag',\n",
    "                                  n_iter=1, random_state=42, min_covar=1e-3)\n",
    "            mdl.startprob_ = np.full(n_states, 1.0 / n_states)\n",
    "            mdl.transmat_  = np.full((n_states, n_states), 1.0 / n_states)\n",
    "            lo = float(diff.min()) if len(diff) else -1.0\n",
    "            hi = float(diff.max()) if len(diff) else  1.0\n",
    "            mdl.means_  = np.linspace(lo, hi, n_states).reshape(-1, 1)\n",
    "            mdl.covars_ = np.full((n_states, 1), 1.0)\n",
    "            models[col] = mdl\n",
    "            continue\n",
    "        X = diff.to_numpy().reshape(-1, 1)\n",
    "        mdl = hmm.GaussianHMM(n_components=n_states, covariance_type='diag',\n",
    "                              n_iter=n_iter, random_state=42, min_covar=1e-3)\n",
    "        mdl.fit(X)\n",
    "        _regularize_markov(mdl)\n",
    "        models[col] = mdl\n",
    "    return models\n",
    "\n",
    "def _discretize_full_with_models(full_df, models, use_pct_change=False):\n",
    "    \"\"\"Discretize ALL rows minus the first using prefit HMMs (no leakage).\"\"\"\n",
    "    disc = pd.DataFrame(index=full_df.index[1:])\n",
    "    for col, mdl in models.items():\n",
    "        series = full_df[col].pct_change() if use_pct_change else full_df[col].diff()\n",
    "        diff = series.dropna().to_numpy().reshape(-1, 1)\n",
    "        try:\n",
    "            _, states = mdl.decode(diff, algorithm=\"viterbi\")\n",
    "        except Exception:\n",
    "            states = mdl.predict(diff)\n",
    "        disc[col] = np.asarray(states, dtype=int)\n",
    "    return disc\n",
    "\n",
    "def _score(df, choice=\"K2\"):\n",
    "    return K2(df) if str(choice).upper() == \"K2\" else BIC(df)\n",
    "\n",
    "BNClass = DiscreteBayesianNetwork if \"DiscreteBayesianNetwork\" in globals() else BayesianNetwork\n",
    "\n",
    "\n",
    "N_STATES       = 3\n",
    "HMM_ITER       = 40\n",
    "USE_PCT_CHANGE = False\n",
    "MAX_INDEGREE   = 3\n",
    "EPS_FLAT       = 1e-6\n",
    "\n",
    "\n",
    "if 'forecast' not in combined.columns:\n",
    "    raise RuntimeError(\"Column 'forecast' (next-day price) not found in `combined`. Define it before this cell.\")\n",
    "if 'WTISPLC' not in combined.columns:\n",
    "    raise RuntimeError(\"Column 'WTISPLC' not found in `combined`. Needed for numeric price metrics.\")\n",
    "\n",
    "#  Fitting HMMs on Training data and discretizing the data\n",
    "hmm_models_global = _fit_hmm_models(train, n_states=N_STATES, n_iter=HMM_ITER, use_pct_change=USE_PCT_CHANGE)\n",
    "disc_all = _discretize_full_with_models(combined, hmm_models_global, use_pct_change=USE_PCT_CHANGE)\n",
    "\n",
    "if 'forecast' not in disc_all.columns:\n",
    "    raise RuntimeError(\"Discretized data missing 'forecast'. Ensure 'forecast' exists before discretization.\")\n",
    "\n",
    "# BN structure once on discretized training data\n",
    "train_disc_initial = disc_all.loc[disc_all.index.intersection(train.index)]\n",
    "hc = HillClimbSearch(train_disc_initial)\n",
    "best_model = hc.estimate(scoring_method=_score(train_disc_initial, \"K2\"),\n",
    "                         max_indegree=MAX_INDEGREE)\n",
    "\n",
    "# LOOCV evaluation window\n",
    "try:\n",
    "    eval_index = val.index.append(test.index)\n",
    "    eval_index = eval_index.intersection(disc_all.index)  # align with discretized index\n",
    "    if len(eval_index) == 0:\n",
    "        raise ValueError(\"Empty eval_index after intersection.\")\n",
    "except Exception:\n",
    "    n = len(disc_all)\n",
    "    eval_index = disc_all.index[int(0.8 * n):]  # last 20% as fallback\n",
    "\n",
    "\n",
    "delta_price = combined.loc[disc_all.index, 'forecast'] - combined.loc[disc_all.index, 'WTISPLC']\n",
    "train_idx_for_delta = train_disc_initial.index.intersection(delta_price.index)\n",
    "state_means = delta_price.loc[train_idx_for_delta].groupby(disc_all.loc[train_idx_for_delta, 'forecast']).mean()\n",
    "\n",
    "for s in range(N_STATES):\n",
    "    if s not in state_means.index:\n",
    "        state_means.loc[s] = 0.0\n",
    "state_means = state_means.sort_index()\n",
    "\n",
    "def _sign(x, eps=EPS_FLAT):\n",
    "    return 0 if abs(x) < eps else (1 if x > 0 else -1)\n",
    "\n",
    "state_dir = state_means.apply(_sign)\n",
    "\n",
    "# LOOCV Looop\n",
    "pred_list, true_list, dates_list = [], [], []\n",
    "p_hat_list, p_true_list, dir_pred_list, dir_true_list = [], [], [], []\n",
    "obs_cols = [c for c in disc_all.columns if c != 'forecast']\n",
    "\n",
    "for t in eval_index:\n",
    "    # Expanding window up to t-1\n",
    "    fold_idx = disc_all.index[disc_all.index < t]\n",
    "    if len(fold_idx) < 50:\n",
    "        continue\n",
    "\n",
    "    train_disc_fold = disc_all.loc[fold_idx]\n",
    "\n",
    "    # Rebuilding BN with same structure and refitting CPDs on the fold\n",
    "    bn = BNClass(best_model.edges())\n",
    "    bn.fit(train_disc_fold, estimator=BayesianEstimator, prior_type=\"K2\")\n",
    "\n",
    "    # Predicting discrete state for t (drop 'forecast' to make it missing)\n",
    "    obs = disc_all.loc[[t], obs_cols]\n",
    "    yhat = int(bn.predict(obs).loc[t, 'forecast'])\n",
    "    ytrue = int(disc_all.loc[t, 'forecast'])\n",
    "\n",
    "    pred_list.append(yhat)\n",
    "    true_list.append(ytrue)\n",
    "    dates_list.append(t)\n",
    "\n",
    "    # Numeric price forecast for t+1 via state -> mean ΔP (from train data)\n",
    "    pt   = float(combined.loc[t, 'WTISPLC'])\n",
    "    dph  = float(state_means.loc[yhat]) if yhat in state_means.index else 0.0\n",
    "    phat = pt + dph\n",
    "    ptrue = float(combined.loc[t, 'forecast'])  # actual next price\n",
    "\n",
    "    p_hat_list.append(phat)\n",
    "    p_true_list.append(ptrue)\n",
    "\n",
    "    # Directional hit-rate (+1/-1/0)\n",
    "    dir_pred_list.append(int(state_dir.loc[yhat]) if yhat in state_dir.index else 0)\n",
    "    dtrue = ptrue - pt\n",
    "    dir_true_list.append(_sign(dtrue))\n",
    "\n",
    "# Metrics ----------\n",
    "loocv_df = pd.DataFrame({\n",
    "    \"date\": dates_list,\n",
    "    \"y_true\": true_list,\n",
    "    \"y_pred\": pred_list,\n",
    "    \"P_true_next\": p_true_list,\n",
    "    \"P_hat_next\": p_hat_list,\n",
    "    \"dir_true\": dir_true_list,\n",
    "    \"dir_pred\": dir_pred_list\n",
    "}).set_index(\"date\")\n",
    "\n",
    "if len(loocv_df) == 0:\n",
    "    print(\"LOOCV produced no observations (check eval window).\")\n",
    "else:\n",
    "    # Classification accuracy\n",
    "    acc = (loocv_df[\"y_true\"] == loocv_df[\"y_pred\"]).mean()\n",
    "    print(f\"LOOCV accuracy (discrete 'forecast' state): {acc:.3f} ({acc*100:.2f}%) on {len(loocv_df)} obs\")\n",
    "\n",
    "    # Confusion Matrix + per-class precision/recall\n",
    "    cm = pd.crosstab(loocv_df[\"y_true\"], loocv_df[\"y_pred\"],\n",
    "                     rownames=[\"Actual\"], colnames=[\"Predicted\"]).reindex(\n",
    "                     index=range(N_STATES), columns=range(N_STATES), fill_value=0)\n",
    "    print(\"\\nConfusion matrix (rows=actual, cols=predicted):\")\n",
    "    print(cm)\n",
    "\n",
    "    with np.errstate(divide='ignore', invalid='ignore'):\n",
    "        recalls = np.diag(cm) / cm.sum(axis=1).replace(0, np.nan)\n",
    "        precis  = np.diag(cm) / cm.sum(axis=0).replace(0, np.nan)\n",
    "    pr_table = pd.DataFrame({\"precision\": precis, \"recall\": recalls}).fillna(0.0)\n",
    "    print(\"\\nPer-class precision/recall:\")\n",
    "    print(pr_table)\n",
    "\n",
    "    # Directional hit-rate\n",
    "    dir_hit = (loocv_df[\"dir_true\"] == loocv_df[\"dir_pred\"]).mean()\n",
    "    print(f\"\\nDirectional hit-rate (Up/Down/Flat): {dir_hit:.3f} ({dir_hit*100:.2f}%)\")\n",
    "\n",
    "    # Numeric price errors\n",
    "    abs_err = np.abs(loocv_df[\"P_true_next\"] - loocv_df[\"P_hat_next\"])\n",
    "    mae  = float(abs_err.mean())\n",
    "    rmse = float(np.sqrt(np.mean((loocv_df[\"P_true_next\"] - loocv_df[\"P_hat_next\"])**2)))\n",
    "    print(f\"\\nPrice MAE: {mae:.4f} | RMSE: {rmse:.4f}\")\n",
    "\n",
    "    # Plotting the results\n",
    "    price_series = combined.loc[loocv_df.index, 'WTISPLC'] if 'WTISPLC' in combined.columns else None\n",
    "    if price_series is not None:\n",
    "        plt.figure(figsize=(12, 5))\n",
    "        plt.plot(price_series.index, price_series.values, label=\"WTI Spot\")\n",
    "        plt.title(\"WTI with LOOCV Predicted 'forecast' State (Bull=2, Neutral=1, Bear=0)\")\n",
    "        plt.xlabel(\"Date\"); plt.ylabel(\"Price\"); plt.legend(); plt.grid(True); plt.show()\n",
    "\n",
    "    # Predicted vs True discrete states\n",
    "    plt.figure(figsize=(12, 3.6))\n",
    "    plt.plot(loocv_df.index, loocv_df[\"y_true\"].values, label=\"True state\", linewidth=1.5)\n",
    "    plt.plot(loocv_df.index, loocv_df[\"y_pred\"].values, label=\"Predicted state\", linewidth=1.0, linestyle=\"--\")\n",
    "    plt.yticks([0,1,2], [\"Bear (0)\", \"Neutral (1)\", \"Bull (2)\"])\n",
    "    plt.title(\"LOOCV: Predicted vs True 'forecast' States\")\n",
    "    plt.xlabel(\"Date\"); plt.ylabel(\"State\"); plt.legend(); plt.grid(True); plt.show()\n",
    "\n",
    "    # Actual vs predicted next-day price\n",
    "    plt.figure(figsize=(12, 5))\n",
    "    plt.plot(loocv_df.index, loocv_df[\"P_true_next\"].values, label=\"Actual P(t+1)\")\n",
    "    plt.plot(loocv_df.index, loocv_df[\"P_hat_next\"].values, label=\"Predicted P(t+1) from state\", linestyle=\"--\")\n",
    "    plt.title(\"Actual vs Predicted Next-Day Price (State-mapped)\")\n",
    "    plt.xlabel(\"Date\"); plt.ylabel(\"Price\"); plt.legend(); plt.grid(True); plt.show()\n",
    "\n",
    "# Static validation error\n",
    "try:\n",
    "    val_input = val_disc.drop(columns=['forecast'])\n",
    "    val_true  = val_disc['forecast'].values\n",
    "    try:\n",
    "        val_pred = model.predict(val_input)['forecast'].values  # use existing model if defined earlier\n",
    "    except Exception:\n",
    "        hc_static = HillClimbSearch(train_disc_initial)\n",
    "        best_static = hc_static.estimate(scoring_method=_score(train_disc_initial, \"K2\"),\n",
    "                                         max_indegree=MAX_INDEGREE)\n",
    "        model_static = BNClass(best_static.edges())\n",
    "        model_static.fit(train_disc_initial, estimator=BayesianEstimator, prior_type=\"K2\")\n",
    "        val_pred = model_static.predict(val_input)['forecast'].values\n",
    "    val_err = np.mean(val_true != val_pred)\n",
    "    print(f\"\\nStatic Validation Error (val split): {val_err:.3f} ({val_err*100:.2f}%)\")\n",
    "except Exception as e:\n",
    "    print(\"\\nStatic Validation Error not computed:\", e)\n",
    "\n",
    "# Static test error\n",
    "try:\n",
    "    test_input = test_disc.drop(columns=['forecast'])\n",
    "    test_true  = test_disc['forecast'].values\n",
    "    try:\n",
    "        test_pred = model.predict(test_input)['forecast'].values\n",
    "    except Exception:\n",
    "        hc_static2 = HillClimbSearch(train_disc_initial)\n",
    "        best_static2 = hc_static2.estimate(scoring_method=_score(train_disc_initial, \"K2\"),\n",
    "                                           max_indegree=MAX_INDEGREE)\n",
    "        model_static2 = BNClass(best_static2.edges())\n",
    "        model_static2.fit(train_disc_initial, estimator=BayesianEstimator, prior_type=\"K2\")\n",
    "        test_pred = model_static2.predict(test_input)['forecast'].values\n",
    "    test_err = np.mean(test_true != test_pred)\n",
    "    print(f\"Static Test Error (test split): {test_err:.3f} ({test_err*100:.2f}%)\")\n",
    "except Exception:\n",
    "    pass\n",
    "\n"
   ]
  },
