   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import eia\n",
    "from fredapi import Fred\n",
    "\n",
    "# --- Step 1: API Keys ---\n",
    "#eia_key = \"YOUR_EIA_API_KEY\"\n",
    "fred_key = \"3a46e2dd6e7fe7836ece0672c05cf448\"\n",
    "datasets_fred = [\n",
    "    'CPIENGSL',\n",
    "    'CAPG211S',\n",
    "    'CAPUTLG211S',\n",
    "    'IPG211S',\n",
    "    'IPG211111CN',\n",
    "    'INDPRO',\n",
    "    'IPN213111N',\n",
    "    'PCU211211',\n",
    "]\n",
    "\n",
    "fred = Fred(api_key=fred_key)\n",
    "\n",
    "# --- Step 2: Dataset Lists ---\n",
    "\n",
    "\n",
    "data_merge = []\n",
    "\n",
    "# --- Step 4: Get FRED data ---\n",
    "for series_id in datasets_fred:\n",
    "    df = pd.DataFrame(fred.get_series(series_id), columns=[series_id])\n",
    "    data_merge.append(df)\n",
    "\n",
    "# --- Step 5: Add WTISPLC + Forecast ---\n",
    "spot = pd.DataFrame(fred.get_series('WTISPLC'), columns=['WTISPLC'])\n",
    "forecast = spot.shift(-1).rename(columns={'WTISPLC': 'forecast'})\n",
    "\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "metadata": {
    "id": "lJDZbxBaLGHo"
   },
   "outputs": [],
   "source": [
    "data_merge += [spot, forecast]\n",
    "\n",
    "# --- Step 6: Combine all into one DataFrame ---\n",
    "data = pd.concat(data_merge, axis=1, join='inner').sort_index()\n",
    "\n"
   ]
  },
