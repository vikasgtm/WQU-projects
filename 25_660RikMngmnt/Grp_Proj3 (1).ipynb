    "# --- STEP 3: HMM Discretization Function ---\n",
    "def discretize_hmm(df, n_states=3):\n",
    "    disc = pd.DataFrame(index=df.index[1:])\n",
    "    for col in df.columns:\n",
    "        diff = df[col].diff().dropna().to_numpy().reshape(-1, 1)\n",
    "        model = hmm.GaussianHMM(n_components=n_states, covariance_type='diag', n_iter=100, random_state=42)\n",
    "        model.fit(diff)\n",
    "        _, states = model.decode(diff, algorithm=\"viterbi\")\n",
    "        disc[col] = states.astype(int)\n",
    "    return disc\n",
    "\n",
    "# --- STEP 4: Discretize train, val, test ---\n",
    "train_disc = discretize_hmm(train)\n",
    "val_disc = discretize_hmm(val)\n",
    "test_disc = discretize_hmm(test)\n",
    "\n",
    "# --- STEP 5: Save if needed ---\n",
    "\n",
    "# --- STEP 6: Hill Climbing Bayesian Network Learning (as in paper) ---\n",
    "hc = HillClimbSearch(train_disc)\n",
    "best_model = hc.estimate(scoring_method=K2(train_disc))\n",
    "\n",
    "# --- STEP 7: Fit the Model with BayesianEstimator ---\n",
    "model = DiscreteBayesianNetwork(best_model.edges())\n",
    "model.fit(train_disc, estimator=BayesianEstimator, prior_type=\"K2\")\n",
    "\n",
    "# --- STEP 8: Show Learned Structure ---\n",
    "edges = list(model.edges())\n",
    "print(\"Learned Bayesian Network Edges:\", edges)\n",
    "\n",
    "# --- STEP 9: Replication Verdict ---\n",
    "if edges:\n",
    "    print(\"Replication SUCCESS: Bayesian structure learned from real data.\")\n",
    "else:\n",
    "    print(\"Replication FAILED: No structure learned.\")\n",
    "\n",
    "# Output edge count\n",
    "print(f\"Total edges learned: {len(edges)}\")"
   ]
  },
